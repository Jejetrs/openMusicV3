{
  "name": "openmusic-api-v3",
  "version": "3.0.0",
  "description": "OpenMusic API Backend with Caching and Message Broker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start-dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate",
    "lint": "eslint ."
  },
  "node-pg-migrate": {
    "databaseUrl": {
      "env": "DATABASE_URL"
    },
    "dir": "migrations",
    "migrationsTable": "pgmigrations"
  },
  "keywords": [
    "music",
    "api",
    "backend"
  ],
  "author": "Jessica Theresia",
  "license": "ISC",
  "dependencies": {
    "@hapi/hapi": "^21.4.4",
    "@hapi/inert": "^7.1.0",
    "@hapi/jwt": "^3.2.1",
    "amqplib": "^0.10.3",
    "auto-bind": "^4.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "joi": "^18.0.1",
    "nanoid": "^3.3.11",
    "pg": "^8.16.3",
    "redis": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "eslint": "^9.39.2",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.11"
  }
}
